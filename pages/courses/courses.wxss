.head { padding: 8rpx 4rpx 20rpx; }
.search-input {
  background: #fff; border-radius: 12rpx;
  padding: 16rpx 24rpx; font-size: 28rpx; margin-bottom: 20rpx;
}
.course { padding: 28rpx 24rpx; }
.c-row { display: flex; align-items: center; justify-content: space-between; }
.c-name { font-size: 34rpx; font-weight: 600; flex: 1; }
.c-role {
  flex-shrink: 0; margin-left: 12rpx;
  font-size: 22rpx; color: #2563eb; background: #e8f0fe;
  border-radius: 20rpx; padding: 2rpx 16rpx;
}
.c-meta { margin-top: 8rpx; font-size: 24rpx; }
.c-title { margin-top: 10rpx; font-size: 26rpx; color: #4b5563; }
.c-go { margin-top: 12rpx; font-size: 24rpx; color: #2563eb; text-align: right; }
.err {
  background: #fde8e8; color: #c0392b; border-radius: 10rpx;
  padding: 16rpx 20rpx; font-size: 26rpx; margin-bottom: 20rpx;
}
.login-btn { display: block; margin: 24rpx 0; }
.empty { text-align: center; padding: 80rpx 0; color: #8a8f99; }
