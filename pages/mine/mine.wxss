.profile { display: flex; align-items: center; }
.avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: #2563eb; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; margin-right: 20rpx;
}
.info { flex: 1; min-width: 0; }
.name { font-size: 32rpx; font-weight: 500; }
.acc { margin-top: 4rpx; font-size: 24rpx; }
.role { font-size: 22rpx; color: #2563eb; background: #e8f0fe; border-radius: 20rpx; padding: 4rpx 18rpx; }
.btn-login { margin-left: 20rpx; color: #2563eb; font-size: 26rpx; }

.stats { display: flex; gap: 16rpx; }
.stat { flex: 1; margin-bottom: 0; padding: 22rpx 16rpx; text-align: center; }
.stat-num { font-size: 44rpx; font-weight: 700; }
.stat-num.ok { color: #1a7f37; }
.stat-label { font-size: 22rpx; margin-top: 6rpx; }

.menu-group { margin-top: 20rpx; }
.menu {
  display: flex; align-items: center; justify-content: space-between;
  font-size: 30rpx; padding: 26rpx 24rpx;
}
.arrow { color: #c9ccd1; font-size: 36rpx; }

.logout {
  margin-top: 32rpx;
  background: #fff; color: #c0392b;
  border-radius: 16rpx; padding: 26rpx 0;
  text-align: center; font-size: 30rpx;
}
.foot { text-align: center; margin: 40rpx 0 20rpx; font-size: 22rpx; }
.foot-demo { color: #2563eb; }
