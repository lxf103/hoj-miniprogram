.login-wrap { padding: 120rpx 60rpx 60rpx; }
.logo { font-size: 96rpx; font-weight: 800; color: #2563eb; text-align: center; letter-spacing: 4rpx; }
.brand { text-align: center; margin: 8rpx 0 60rpx; font-size: 26rpx; }

.input {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}
.btn {
  background: #2563eb; color: #fff; border-radius: 12rpx;
  padding: 24rpx 0; text-align: center; font-size: 32rpx; margin-top: 10rpx;
}
.btn-off { background: #9bb4e8; }
.err {
  background: #fde8e8; color: #c0392b; border-radius: 10rpx;
  padding: 16rpx 20rpx; font-size: 26rpx; margin-bottom: 24rpx;
}
.tip { text-align: center; margin-top: 28rpx; font-size: 24rpx; }
