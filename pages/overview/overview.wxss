/* 演示模式提示条 */
.demo-strip {
  display: flex; align-items: center;
  background: #e8f0fe; border: 2rpx solid #c7dafc;
  border-radius: 12rpx; padding: 14rpx 20rpx; margin-bottom: 20rpx;
}
.demo-strip-tag {
  flex-shrink: 0; background: #2563eb; color: #fff;
  font-size: 20rpx; border-radius: 6rpx; padding: 2rpx 12rpx; margin-right: 14rpx;
}
.demo-strip-txt { font-size: 22rpx; color: #3b5b96; }

.hello { padding: 16rpx 4rpx 8rpx; }
.hi { font-size: 46rpx; font-weight: 700; }
.sub { margin-top: 8rpx; }
.role-tag {
  display: inline-block;
  background: #e8f0fe; color: #2563eb;
  border-radius: 20rpx; padding: 2rpx 16rpx; font-size: 22rpx;
}

.stats { display: flex; gap: 16rpx; margin-top: 20rpx; }
.stat { flex: 1; margin-bottom: 0; padding: 24rpx 20rpx; }
.stat-label { color: #6b7280; font-size: 24rpx; }
.stat-num { font-size: 52rpx; font-weight: 700; margin-top: 8rpx; }

.sec-row { display: flex; align-items: baseline; justify-content: space-between; }
.sec-title { font-size: 32rpx; font-weight: 600; margin: 32rpx 0 12rpx; }
.sec-more { font-size: 24rpx; }

.hw { display: flex; align-items: center; justify-content: space-between; }
.hw-main { flex: 1; min-width: 0; }
.hw-title { font-size: 30rpx; font-weight: 500; }
.hw-sub { margin-top: 6rpx; }
.hw-right { text-align: right; flex-shrink: 0; margin-left: 16rpx; }
.hw-status { font-size: 24rpx; color: #2563eb; margin-top: 6rpx; }

.due-open { font-size: 22rpx; color: #6b7280; }
.due-urgent { font-size: 22rpx; color: #c0392b; font-weight: 600; }
.due-over { font-size: 22rpx; color: #9ca3af; }
.due- { font-size: 22rpx; color: #6b7280; }

.sub { padding: 22rpx 24rpx; }
.sub-top { display: flex; justify-content: space-between; align-items: center; }
.sub-title { font-size: 28rpx; flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.sub-foot { margin-top: 8rpx; font-size: 22rpx; }

.quick { margin: 32rpx 0 20rpx; }
.quick-btn {
  background: #2563eb; color: #fff; border-radius: 12rpx;
  padding: 24rpx 0; text-align: center; font-size: 30rpx;
}

.login-card { display: flex; align-items: center; justify-content: space-between; margin-top: 40rpx; }
.lc-text { font-size: 32rpx; color: #2563eb; font-weight: 500; }
.lc-go { color: #2563eb; font-size: 32rpx; }

.empty { text-align: center; padding: 60rpx 0; color: #8a8f99; }
