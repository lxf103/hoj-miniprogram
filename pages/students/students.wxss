.c-name { font-size: 34rpx; font-weight: 700; }
.c-meta { margin-top: 8rpx; font-size: 24rpx; }

.stats { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.stat { flex: 1; margin-bottom: 0; padding: 20rpx 12rpx; text-align: center; }
.stat-num { font-size: 44rpx; font-weight: 700; }
.stat-num.ok { color: #1a7f37; }
.stat-num.warn { color: #b76e00; }
.stat-label { font-size: 22rpx; margin-top: 4rpx; }

.search-input {
  background: #fff; border-radius: 12rpx;
  padding: 16rpx 24rpx; font-size: 28rpx; margin-bottom: 16rpx;
}
.chips { display: flex; gap: 14rpx; margin-bottom: 16rpx; }
.chip {
  font-size: 24rpx; color: #6b7280; background: #fff;
  border-radius: 24rpx; padding: 8rpx 26rpx;
}
.chip-on { background: #2563eb; color: #fff; }

.stu { display: flex; align-items: center; padding: 22rpx 24rpx; }
.stu-avatar {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  background: #e8f0fe; color: #2563eb;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; margin-right: 18rpx; flex-shrink: 0;
}
.stu-main { flex: 1; min-width: 0; }
.stu-name { font-size: 30rpx; font-weight: 500; }
.stu-sub { font-size: 22rpx; margin-top: 4rpx; }
.stu-right { text-align: right; flex-shrink: 0; margin-left: 12rpx; }
.stu-passed { font-size: 26rpx; color: #1a7f37; font-weight: 600; }
.stu-att { font-size: 22rpx; margin-top: 2rpx; }
.stu-go { font-size: 22rpx; color: #2563eb; margin-top: 6rpx; }

.err-text { color: #c0392b; }
.empty { text-align: center; padding: 60rpx 0; color: #8a8f99; }
